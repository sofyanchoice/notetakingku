rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Setiap pengguna hanya boleh membaca/menulis dokumen catatannya sendiri,
    // yang ID-nya adalah UID Firebase Auth miliknya.
    match /notes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
